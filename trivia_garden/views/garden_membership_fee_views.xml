<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--

    * a list view and a form view of the fees;
    * in the header of the form: the state as a statusbar, and a "Mark as paid" button
      (method action_mark_paid) only visible on draft fees;
    * an action opening the fees, and a menu "Membership Fees" (in views/menus.xml).
    -->
    <record id="garden_fees_action" model="ir.actions.act_window">
        <field name="name">Membership Fees</field>
        <field name="res_model">garden.membership.fee</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="garden_membership_fee_view_list" model="ir.ui.view">
        <field name="name">garden.membership.fee.list</field>
        <field name="model">garden.membership.fee</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"/>
                <field name="year"/>
                <field name="amount"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="garden_membership_fee_view_form" model="ir.ui.view">
        <field name="name">garden.membership.form</field>
        <field name="model">garden.membership.fee</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_paid"
                            type="object"
                            string="Mark membership as paid"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="partner_id"/>
                        <field name="year"/>
                        <field name="amount"/>
                        <field name="state" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
