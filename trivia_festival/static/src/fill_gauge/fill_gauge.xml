<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="trivia_festival.FillGauge">
        <div class="w-100">
            <div class="progress" style="height: 1rem;">
                <div class="progress-bar" t-att-class="this.color" t-att-style="'width: ' + this.percentage + '%'"/>
            </div>
            <span><t t-out="this.value"/> / <t t-out="this.max"/> (<t t-out="this.percentage"/> %)</span>
        </div>
    </t>

</templates>
