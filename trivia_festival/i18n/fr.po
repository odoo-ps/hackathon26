#. module: trivia_festival
#. odoo-python
#: code:addons/trivia_festival/models/trivia_challenge.py:0
msgid "3. Attendees checked in from the welcome desk"
msgstr "3. Participants enregistrés à l’accueil"

#. module: trivia_festival
#: model_terms:trivia.challenge,description:trivia_festival.challenge_festival
msgid "<b>Open the doors!</b> Check 3 attendees in from your welcome desk."
msgstr "<b>Ouvrez les portes !</b> Enregistrez l’arrivée de 3 participants depuis votre accueil."

#. module: trivia_festival
#: model_terms:trivia.challenge,description:trivia_festival.challenge_festival
msgid ""
"<b>The fill gauge</b> (<code>static/src/fill_gauge/</code>, "
"<code>views/event_event_views.xml</code>): a field widget "
"<code>festival_fill_gauge</code> which shows the seats taken as a progress "
"bar, green, orange then red, used on the form of the event."
msgstr "<b>La jauge de remplissage</b> (<code>static/src/fill_gauge/</code>, <code>views/event_event_views.xml</code>) : un widget de champ <code>festival_fill_gauge</code> qui affiche les places prises sous forme de barre de progression, verte, orange puis rouge, utilisé sur la fiche de l’événement."

#. module: trivia_festival
#: model_terms:trivia.challenge,description:trivia_festival.challenge_festival
msgid ""
"<b>The welcome desk</b> (<code>static/src/kiosk/</code>, "
"<code>views/menus.xml</code>): a client action <code>festival_kiosk</code> "
"which lists the registrations, with a <i>Check in</i> button that calls the "
"server, and a <i>Welcome Desk</i> menu."
msgstr "<b>L’accueil</b> (<code>static/src/kiosk/</code>, <code>views/menus.xml</code>) : une action client <code>festival_kiosk</code> qui liste les inscriptions, avec un bouton <i>Check in</i> qui appelle le serveur, et un menu <i>Welcome Desk</i>."

